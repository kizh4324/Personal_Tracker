{
  "harness-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/harness_gate.py --hook"
          }
        ]
      }
    ]
  },
  "domain-purity-check": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/domain_purity_check.py --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/domain_purity_check.py --hook"
          }
        ]
      }
    ]
  }
}
